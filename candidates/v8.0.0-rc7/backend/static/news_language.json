  "patterns": [
    {
      "pattern": "^Can (?:the )?(.+?)['’] defense again (?:silence|stop|shut down) (?:the )?(.+?)['’] (?:hot|red-hot) offense (Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday)\\?$",
      "template": "A defesa dos {1} pode voltar a conter o ataque em boa fase dos {2} {d3}?"
    },
    {
      "pattern": "^Fantasy football buzz: Expect (.+?)['’] (.+?) to (?:retain|keep) (RB1|WR1|TE1|QB1) role with (.+?) out$",
      "template": "Fantasy Football: {2} deve seguir como {3} dos {1}, com {4} fora."
    },
    {
      "pattern": "^(.+?) DNP due to (hamstring|knee|ankle|groin|glute|calf|shoulder|foot|toe|wrist|back|concussion)(?: issue)?$",
      "template": "{1} não treinou por problema em {b2}."
    },
    {
      "pattern": "^(.+?) (?:does not|doesn't|did not) practice(?: on)? (Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday)$",
      "template": "{1} não treinou {d2}."
    },
    {
      "pattern": "^(.+?) (?:does not|doesn't|did not) practice$",
      "template": "{1} não treinou."
    },
    {
      "pattern": "^(.+?) officially limited(?: at practice)? (Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday)$",
      "template": "{1} teve participação limitada no treino {d2}."
    },
    {
      "pattern": "^(.+?) (?:limited at practice|limited practice)(?: on)? (Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday)$",
      "template": "{1} teve participação limitada no treino {d2}."
    },
    {
      "pattern": "^(.+?) (?:is )?expected to play (Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday)$",
      "template": "{1} deve jogar {d2}."
    },
    {
      "pattern": "^(.+?) (?:is )?(?:ruled out|out) for (?:Week|week) (\\d+)$",
      "template": "{1} está fora da Semana {2}."
    },
    {
      "pattern": "^(.+?) (?:is )?(?:ruled out|out) (?:for )?(Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday)$",
      "template": "{1} está fora do jogo {d2}."
    },
    {
      "pattern": "^(.+?) (?:is )?(?:officially )?questionable for (Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday)$",
      "template": "{1} é dúvida para o jogo {d2}."
    },
    {
      "pattern": "^(.+?) (?:is )?(?:good to go|cleared to play) (Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday)$",
      "template": "{1} está liberado para jogar {d2}."
    },
    {
      "pattern": "^(.+?) \\(([^)]+)\\) off injury report (Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday)$",
      "template": "{1} ({b2}) deixou o relatório de lesões para o jogo {d3}."
    },
    {
      "pattern": "^(.+?) (?:is )?expected to return (?:Week|week) (\\d+)$",
      "template": "{1} tem retorno previsto para a Semana {2}."
    },
    {
      "pattern": "^(.+?) (?:was |is )?placed on (?:IR|injured reserve)$",
      "template": "{1} foi colocado na IR."
    },
    {
      "pattern": "^(.+?) place(?:s)? (?:veteran )?(?:QB|RB|WR|TE|LT|DE|DT|LB|CB|S) (.+?) on IR with (hamstring|knee|ankle|groin|glute|calf|shoulder|foot|toe|wrist|back) injury$",
      "template": "{1} colocam {2} na IR por lesão em {b3}."
    },
    {
      "pattern": "^(.+?) practices in full, plans to play (MNF|SNF|TNF)$",
      "template": "{1} treinou sem limitações e pretende jogar no {2}."
    },
    {
      "pattern": "^Fantasy football Week (\\d+) inactives: (.+?) out$",
      "template": "Fantasy Football: {2} estão fora na Semana {1}."
    },
    {
      "pattern": "^Fantasy football (flex and superflex|PPR and superflex) rankings (?:for )?Week (\\d+)$",
      "template": "Ranking de Fantasy Football para a Semana {2}: {1}."
    },
    {
      "pattern": "^Fantasy football rankings (?:for )?Week (\\d+): (Quarterback|Running back|Wide receiver|Tight end|Kicker|D/ST|IDP)$",
      "template": "Ranking de Fantasy Football para a Semana {1}: {2}."
    },
    {
      "pattern": "^(.+?) Week (\\d+) Outlook for Fantasy Football$",
      "template": "Perspectiva de {1} para a Semana {2} do Fantasy Football."
    },
    {
      "pattern": "^Who Should I Start for Fantasy Football Week (\\d+)\\?$",
      "template": "Quem devo escalar no Fantasy Football na Semana {1}?"
    },
    {
      "pattern": "^(.+?) (?:is )?ready for (Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday)$",
      "template": "{1} está pronto para o jogo {d2}."
    }
